# Pins for the CI scripts (W-13, W-15). Not runtime/pins.env: that file is the boxes' build input, and editing it forces
# a runtime rebuild. Each URL and SHA-256 was checked against the vendor's own checksum before it was written here.

# Temurin 25.0.4.1+1 for Linux x64, the same release runtime/pins.env pins for the Mac (aarch64). The SHA-256 agrees with
# the Adoptium API (api.adoptium.net/v3/assets/release_name/eclipse/jdk-25.0.4.1%2B1) and with the release's .sha256.txt.
TEMURIN_LINUX_X64_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_linux_hotspot_25.0.4.1_1.tar.gz
TEMURIN_LINUX_X64_SHA256=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e

# gitleaks v8.30.1, linux x64: the leaks job's history scan. The SHA-256 is the line for this file in the release's own
# gitleaks_8.30.1_checksums.txt, and the downloaded file hashed to it.
GITLEAKS_LINUX_X64_URL=https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz
GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
