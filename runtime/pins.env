# What the runtime is built from, pinned. Change a pin here, rebuild, rerun every test in runtime/test.
#
# Checked by build.sh; a mismatch stops it:
#   - the Temurin JDK: JDK_SHA256, and both checksums Adoptium publishes for it, when build.sh downloads
#     it (a JDK already unpacked with its VERIFIED marker is not checked again);
#   - TeaVM and teavm-javac: the commits below (git object hashes);
#   - the jdk25u revision teavm-javac's gradle.properties names at JAVAC_COMMIT: JDK25U_REVISION;
#   - the jdk25u source zip javac is compiled from: JDK25U_ZIP_SHA256, before any variant is built;
#   - the Gradle distribution the wrapper runs: GRADLE_DIST_SHA256 (the wrapper checks each download; a
#     distribution unpacked before the pin existed is removed and downloaded again);
#   - the published jars and POMs overlay/build-overlay.sh reads from the Gradle cache, which are exactly
#     the ones OVERLAY_INPUTS_SHA256 lists (its jars are the classpath the patched classes are compiled
#     against; the teavm-core and teavm-classlib jars and POMs are also copied whole into the fork's repo);
#   - every dependency and plugin Gradle resolves: gradle/verification-metadata.xml (SHA-256, Gradle's own
#     dependency verification), except teavm-core and teavm-classlib 0.13.1-fork1, which the overlay
#     builds on the spot from the checked inputs above and runtime/patches/ (trusted there by version).
#   - the files release/package.sh fetches for a release (license texts and the sources jars it ships):
#     RELEASE_INPUTS_SHA256, checked on every package run, cached copy or not.
# Not checked here: the JDK and the Gradle distribution once unpacked (only their downloads are checked); the wrapper jar
# (gradle/wrapper/gradle-wrapper.jar, part of the teavm-javac commit); the Node.js that runs the tests.
# Where the pins came from: JDK_SHA256 from Adoptium (API and .sha256.txt). GRADLE_DIST_SHA256 from
# services.gradle.org's gradle-9.1.0-bin.zip.sha256, the same value gradle.org/release-checksums lists.
# OVERLAY_INPUTS_SHA256 from the files in the cache, each matching Maven Central's published .sha256
# (jackson-annotations 2.14.2, which Central gives only a .sha1 for: that). JDK25U_ZIP_SHA256 from the
# downloaded zip; GitHub publishes no checksum for an archive, so it rests on separate downloads agreeing.
JDK_RELEASE="jdk-25.0.4.1+1"
JDK_FILE="OpenJDK25U-jdk_aarch64_mac_hotspot_25.0.4.1_1.tar.gz"
JDK_URL="https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/$JDK_FILE"
JDK_SHA256="61979887f7506a24a57439ff99adb8b3a7fc89977d9cfe3b8984f58a981b7b9d"
JDK_API="https://api.adoptium.net/v3/assets/release_name/eclipse/jdk-25.0.4.1%2B1?architecture=aarch64&image_type=jdk&os=mac&project=jdk"
TEAVM_TAG="0.13.1"
TEAVM_COMMIT="b3a245b7d9034ff35cdfab2def057a3d4f256efb"
JAVAC_COMMIT="2ddcf02e4983e5c74d45b945c2fd41a829358828"
JDK25U_REVISION="6c48f4ed707bf0b15f9b6098de30db8aae6fa40f"
JDK25U_ZIP_SHA256="4f3d4746948c90682ece32e4fc1b40a7828d1e68e9abd2e68316ab8076792458"
GRADLE_DIST="gradle-9.1.0-bin.zip"
GRADLE_DIST_SHA256="a17ddd85a26b6a7f5ddb71ff8b05fc5104c0202c6e64782429790c933686c806"
# One line per file, "<sha256>  <group>/<artifact>/<version>/<file>", the path inside the Gradle module
# cache (caches/modules-2/files-2.1) without the directory Gradle names after the file's SHA-1.
OVERLAY_INPUTS_SHA256="
2c6869d505cf60dc066734b7d50339f975bd3adc635e26a78abb71acb4473c0d  com.fasterxml.jackson.core/jackson-annotations/2.14.2/jackson-annotations-2.14.2.jar
a250f7baf877767af72634cd3f19d30f2a6b8a3fb16bd3931b99fde1b17cd12d  org.teavm/teavm-classlib/0.13.1/teavm-classlib-0.13.1.jar
1d7742bb365e620a41fe58b5177179ec45b32b4c8ec61faee6becdfe605eb041  org.teavm/teavm-classlib/0.13.1/teavm-classlib-0.13.1.pom
