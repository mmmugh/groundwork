+    // teavm-fork: a floating-point compare(a, b) is 1 when either operand is NaN (fcmpg, dcmpg), so
+    // compare(a, b) > 0 is !(a <= b) and compare(a, b) >= 0 is !(a < b): a > b and a >= b are false for NaN.
+    private static Expr fuseComparison(BinaryOperation operation, BinaryExpr comparison) {
+        Expr a = comparison.getFirstOperand();
+        Expr b = comparison.getSecondOperand();
+        boolean floating = comparison.getType() == OperationType.FLOAT
+                || comparison.getType() == OperationType.DOUBLE;
+        if (floating && operation == BinaryOperation.GREATER) {
+            return Expr.invert(BinaryExpr.binary(BinaryOperation.LESS_OR_EQUALS, comparison.getType(), a, b));
+        } else if (floating && operation == BinaryOperation.GREATER_OR_EQUALS) {
+            return Expr.invert(BinaryExpr.binary(BinaryOperation.LESS, comparison.getType(), a, b));
+        }
+        return BinaryExpr.binary(operation, comparison.getType(), a, b);
+    }
+
+    private static BinaryOperation mirror(BinaryOperation operation) {
+        switch (operation) {
+            case LESS:
+                return BinaryOperation.GREATER;
+            case LESS_OR_EQUALS:
+                return BinaryOperation.GREATER_OR_EQUALS;
+            case GREATER:
+                return BinaryOperation.LESS;
+            case GREATER_OR_EQUALS:
+                return BinaryOperation.LESS_OR_EQUALS;
+            default:
+                return operation;
+        }
+    }
