@@ -60,6 +61,12 @@ public class StdlibConverter extends ClassVisitor {
     // The converter used to export them under the Java-side name, so javac reported
     // "cannot find symbol: method getMessage()". Key: name + descriptor (original), value: JDK name.
     private final Map<String, String> renames;
+    // teavm-fork: a method renamed onto a name and descriptor that the stub already has is left out of it, not
+    // declared twice. TObject.equals0(TObject) and TAbstractList.equals0(TObject) become equals(Object) beside
+    // the class's own equals(Object), and THashSet's and TTreeSet's clone0() become clone() beside their own
+    // clone(); declared twice, javac said "reference to equals is ambiguous" for every type that inherits
+    // Object's or AbstractList's equals. Key: name + descriptor (original), as in renames.
+    private final Set<String> duplicates = new HashSet<>();
 
     public StdlibConverter(ClassVisitor cv) {
         this(cv, Map.of());
@@ -111,6 +118,34 @@ public class StdlibConverter extends ClassVisitor {
         return result;
     }
 
+    // teavm-fork: finds the renamed methods whose new name plus renamed descriptor the stub already has, either
+    // from a public or protected method declared under its own name (which is kept, whatever the order) or from
+    // a renamed method written before it.
+    void skipRenamedDuplicates(byte[] classFile) {
+        var kept = new HashSet<String>();
+        var renamed = new LinkedHashMap<String, String>();
+        new ClassReader(classFile).accept(new ClassVisitor(Opcodes.ASM9) {
+            @Override
+            public MethodVisitor visitMethod(int access, String name, String desc, String signature,
+                    String[] exceptions) {
+                if ((access & (Opcodes.ACC_PUBLIC | Opcodes.ACC_PROTECTED)) != 0) {
+                    var target = renames.get(name + desc);
+                    if (target == null) {
+                        kept.add(name + renameMethodDesc(desc));
+                    } else {
+                        renamed.put(name + desc, target + renameMethodDesc(desc));
+                    }
+                }
+                return null;
+            }
+        }, ClassReader.SKIP_CODE | ClassReader.SKIP_FRAMES | ClassReader.SKIP_DEBUG);
+        for (var entry : renamed.entrySet()) {
+            if (!kept.add(entry.getValue())) {
+                duplicates.add(entry.getKey());
+            }
+        }
+    }
+
     @Override
     public void visit(int version, int access, String name, String signature, String superName, String[] interfaces) {
         if ((access & Opcodes.ACC_PRIVATE) != 0) {
@@ -187,6 +222,9 @@ public class StdlibConverter extends ClassVisitor {
         if ((access & Opcodes.ACC_PUBLIC) == 0 && ((access & Opcodes.ACC_PROTECTED) == 0)) {
             return null;
         }
+        if (duplicates.contains(name + desc)) {
+            return null;
+        }
         name = renames.getOrDefault(name + desc, name);
         desc = renameMethodDesc(desc);
         if (signature != null) {
