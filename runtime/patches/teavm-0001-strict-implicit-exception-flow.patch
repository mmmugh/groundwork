     private AbstractInstructionAnalyzer reader = new AbstractInstructionAnalyzer() {
+        // teavm-fork: in strict mode the backend later inserts null checks (NullCheckInsertion) and
+        // bound checks (BoundCheckInsertion) that throw NullPointerException /
+        // ArrayIndexOutOfBoundsException. Those instructions do not exist yet during dependency
+        // analysis, so without this the exception types never reach catch variables or a method's
+        // thrown set, and virtual calls on a caught exception (e.toString()) are devirtualized against
+        // an incomplete type set (observed: Wasm trap, or "null" instead of the exception text).
+        private void implicitNullPointer() {
+            if (dependencyAnalyzer.isStrict()) {
+                currentExceptionConsumer.consume(dependencyAnalyzer.getClassType("java.lang.NullPointerException"));
+            }
+        }
+
+        private void implicitArrayAccess() {
+            if (dependencyAnalyzer.isStrict()) {
+                implicitNullPointer();
+                currentExceptionConsumer.consume(dependencyAnalyzer.getClassType(
+                        "java.lang.ArrayIndexOutOfBoundsException"));
+            }
+        }
+
+        @Override
+        public void getField(VariableReader receiver, VariableReader instance, FieldReference field,
+                ValueType fieldType) {
+            super.getField(receiver, instance, field, fieldType);
+            if (instance != null) {
+                implicitNullPointer();
+            }
+        }
+
+        @Override
+        public void putField(VariableReader instance, FieldReference field, VariableReader value,
+                ValueType fieldType) {
+            super.putField(instance, field, value, fieldType);
+            if (instance != null) {
+                implicitNullPointer();
+            }
+        }
+
+        @Override
+        public void arrayLength(VariableReader receiver, VariableReader array) {
+            super.arrayLength(receiver, array);
+            implicitNullPointer();
+        }
+
+        @Override
+        public void invoke(VariableReader receiver, VariableReader instance, MethodReference method,
+                List<? extends VariableReader> arguments, InvocationType type) {
+            super.invoke(receiver, instance, method, arguments, type);
+            if (instance != null) {
+                implicitNullPointer();
+            }
+        }
+
         @Override
         public void assign(VariableReader receiver, VariableReader assignee) {
             DependencyNode valueNode = nodes[assignee.getIndex()];
@@ -305,6 +360,7 @@ class DependencyGraphBuilder {
         @Override
         public void getElement(VariableReader receiver, VariableReader array, VariableReader index,
                 ArrayElementType type) {
+            implicitArrayAccess();
             if (isPrimitive(type)) {
                 return;
             }
@@ -318,6 +374,7 @@ class DependencyGraphBuilder {
         @Override
         public void putElement(VariableReader array, VariableReader index, VariableReader value,
                 ArrayElementType type) {
+            implicitArrayAccess();
             if (isPrimitive(type)) {
                 return;
             }
