# F1. Strict mode: make dependency analysis aware of the NullPointerException /
# ArrayIndexOutOfBoundsException that the null/bound checks inserted later (NullCheckInsertion,
# BoundCheckInsertion) will throw. Without it, catch variables and methods' thrown sets miss those
# types and a virtual call on a caught exception (e.toString(), e.getMessage()) is devirtualized
# against an incomplete type set: a Wasm trap or the text "null" instead of the exception.
# Only active when TeaVMBuilder.setStrict(true).
#
# Applies to: github.com/konsoletyper/teavm tag 0.13.1 (b3a245b7)

diff --git a/core/src/main/java/org/teavm/dependency/DependencyAnalyzer.java b/core/src/main/java/org/teavm/dependency/DependencyAnalyzer.java
index 791879e..4755cc8 100644
--- a/core/src/main/java/org/teavm/dependency/DependencyAnalyzer.java
+++ b/core/src/main/java/org/teavm/dependency/DependencyAnalyzer.java
@@ -158,6 +158,12 @@ public abstract class DependencyAnalyzer implements DependencyInfo {
         classSource.strict = strict;
     }
 
+    // teavm-fork: DependencyGraphBuilder needs to know whether implicit runtime checks
+    // (null / array bounds) will be inserted later, so it can model the exceptions they throw.
+    boolean isStrict() {
+        return classSource.strict;
+    }
+
     public void setAsyncSupported(boolean asyncSupported) {
         this.asyncSupported = asyncSupported;
     }
