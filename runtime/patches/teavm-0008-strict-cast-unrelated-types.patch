# F1. WasmGC codegen replaced a cast between unrelated classes by 'drop value; push null' even in strict
# mode, so (String) Integer.valueOf(1) silently produced null instead of throwing ClassCastException
# (pre-existing in upstream; strict and non-strict). In strict mode the value is now null-checked:
# null passes (as in Java), anything else throws ClassCastException.
#
# Applies to: github.com/konsoletyper/teavm tag 0.13.1 (b3a245b7)

diff --git a/core/src/main/java/org/teavm/backend/wasm/generate/gc/methods/WasmGCGenerationVisitor.java b/core/src/main/java/org/teavm/backend/wasm/generate/gc/methods/WasmGCGenerationVisitor.java
index 9796a4d..138bd62 100644
--- a/core/src/main/java/org/teavm/backend/wasm/generate/gc/methods/WasmGCGenerationVisitor.java
+++ b/core/src/main/java/org/teavm/backend/wasm/generate/gc/methods/WasmGCGenerationVisitor.java
@@ -591,8 +591,19 @@ public class WasmGCGenerationVisitor extends BaseWasmGenerationVisitor {
                 var block = new WasmBlock(false);
                 block.setType(targetType.asBlock());
                 block.setLocation(expr.getLocation());
-                block.getBody().add(new WasmDrop(result));
-                block.getBody().add(new WasmNullConstant(targetType));
+                if (!expr.isWeak() && context.isStrict()) {
+                    // teavm-fork: unrelated types, so the cast can only succeed for null. This branch used
+                    // to return null for ANY value, even in strict mode: (String) Integer.valueOf(1)
+                    // silently produced null instead of throwing ClassCastException.
+                    var valueToCheck = exprCache.create(result, sourceType, expr.getLocation(), block.getBody());
+                    var ifNull = new WasmBranch(new WasmIsNull(valueToCheck.expr()), block);
+                    ifNull.setResult(new WasmNullConstant(targetType));
+                    block.getBody().add(new WasmDrop(ifNull));
+                    generateThrowCCE(expr.getLocation(), block.getBody());
+                } else {
+                    block.getBody().add(new WasmDrop(result));
+                    block.getBody().add(new WasmNullConstant(targetType));
+                }
                 result = block;
                 return;
             }
