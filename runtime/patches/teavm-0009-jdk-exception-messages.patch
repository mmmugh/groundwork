+            char c = string.charAt(index);
+            if (c == '.') {
+                if (point) {
+                    return new NumberFormatException("multiple points");
+                }
+                point = true;
+            } else if (c < '0' || c > '9') {
+                break;
+            }
+        }
+        return new NumberFormatException("For input string: \"" + string + "\"");
+    }
