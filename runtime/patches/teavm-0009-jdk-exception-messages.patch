+    // teavm-fork: the JDK's NumberFormatException text for a string Double.parseDouble or Float.parseFloat
+    // rejects, as observed on the pinned JDK: "empty String" when nothing but whitespace is left,
+    // "multiple points" when the leading run of digits and points holds a second point, and otherwise
+    // For input string: "<the string as given>".
+    static NumberFormatException invalidNumber(String string) {
+        int start = 0;
+        int end = string.length();
+        while (start < end && string.charAt(start) <= ' ') {
+            ++start;
+        }
+        while (end > start && string.charAt(end - 1) <= ' ') {
+            --end;
+        }
+        if (start == end) {
+            return new NumberFormatException("empty String");
+        }
+        int index = start;
+        if (string.charAt(index) == '+' || string.charAt(index) == '-') {
+            ++index;
+        }
+        boolean point = false;
