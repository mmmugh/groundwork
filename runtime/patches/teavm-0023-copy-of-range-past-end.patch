     public static double[] copyOfRange(double[] array, int from, int to) {
-        double[] result = new double[to - from];
-        for (int i = from; i < to; ++i) {
-            result[i - from] = array[i];
+        double[] result = new double[copyOfRangeLength(array.length, from, to, "double")];
+        int sz = TMath.min(array.length - from, result.length);
