# Engine wave E4. Arrays.copyOfRange(scores, 1, 5) on a 3-element int[] is [85, 77, 0, 0] on the pinned JDK; the
# fork threw ArrayIndexOutOfBoundsException ("Index 3 out of bounds for length 3"), for every overload, because
# each one allocated to - from elements and then read the original from "from" through "to".
#   - The rule, from the pinned JDK's observed output (runtime/test/cases.mjs, the E4 cases; E4-copy-of-range-
#     matrix runs all ten overloads over 14 ranges of a 3-element array, E4-copy-of-range-edges the edges):
#       * the copy has to - from elements; those the original has are copied, the rest stay 0, 0.0, false, '\0'
#         or null (to past the end, and from equal to the length, give a padded copy);
#       * if to - from, computed in int, is below 0, IllegalArgumentException "<from> > <to>", before anything
#         else ("5 > 3"; "-2147483648 > 0" and "-5 > 2147483647", where the subtraction overflows);
#       * else if from is below 0, ArrayIndexOutOfBoundsException "arraycopy: source index <from> out of bounds
#         for <type>[<length>]", <type> being int, byte, short, char, long, float, double or boolean, and
#         "object array" for every reference type (String[], Integer[], the overload with a new type); an empty
#         range starting below 0 throws it too;
#       * else if from is past the end, ArrayIndexOutOfBoundsException "arraycopy: length <length - from> is
#         negative" ("length -1" for (4, 5) and (4, 4) on 3 elements, "length -7" for (10, 10));
#       * the overload with a new array type behaves the same, its padding null.
#   - Every overload now checks the range with one helper that throws those exceptions with that text, allocates
#     to - from elements and copies the min(length - from, to - from) the original has, in TeaVM's own loop. Left
#     as it was: in the overload with a new array type, an element that type cannot hold throws
#     ClassCastException (TeaVM's cast), where the JDK throws ArrayStoreException with an "arraycopy: ... type
#     mismatch" message; that is not what E4 is about and is reported, not fixed. System.arraycopy is not used:
#     on Wasm GC, its intrinsic copies erased generic arrays (Integer[] typed as T[]) as raw Object[] and trapped.
#
# Written from TeaVM's own source (classlib/src/main/java/org/teavm/classlib/java/util/TArrays.java) and the pinned
# JDK's observed output; no OpenJDK source was opened (clean room, D14). Written by a subagent (Claude Opus 5.5), a
# language model whose training may include OpenJDK, so the patch was read for names or structure that look
# recalled rather than derived: the helper's name and order of checks follow the observed precedence above, the
# messages are the JDK's observed text, and the copy is TeaVM's own loop.
#
# Applies to: github.com/konsoletyper/teavm tag 0.13.1 (b3a245b7). No other patch touches TArrays.

diff --git a/classlib/src/main/java/org/teavm/classlib/java/util/TArrays.java b/classlib/src/main/java/org/teavm/classlib/java/util/TArrays.java
index ef3ce22..9a5cc0f 100644
--- a/classlib/src/main/java/org/teavm/classlib/java/util/TArrays.java
+++ b/classlib/src/main/java/org/teavm/classlib/java/util/TArrays.java
@@ -130,85 +130,119 @@ public class TArrays extends TObject {
         return result;
     }
 
+    // teavm-fork: the pinned JDK's copyOfRange, as observed (runtime/test/cases.mjs, the E4 cases). A range whose
+    // to - from is below 0 throws IllegalArgumentException "<from> > <to>"; then a from below 0 throws
+    // ArrayIndexOutOfBoundsException "arraycopy: source index <from> out of bounds for <type>[<length>]", where
+    // <type> is the primitive's name or "object array"; then a from past the end throws
+    // ArrayIndexOutOfBoundsException "arraycopy: length <length - from> is negative". Otherwise the copy has
+    // to - from elements, and those past the end of the original stay 0, false, '\0' or null. TeaVM's version
+    // allocated to - from and read the original through to, so a "to" past the end threw. Returns to - from.
+    private static int copyOfRangeLength(int length, int from, int to, String type) {
+        int newLength = to - from;
+        if (newLength < 0) {
+            throw new IllegalArgumentException(from + " > " + to);
+        }
+        if (from < 0) {
+            throw new ArrayIndexOutOfBoundsException("arraycopy: source index " + from + " out of bounds for "
+                    + type + "[" + length + "]");
+        }
+        if (from > length) {
+            throw new ArrayIndexOutOfBoundsException("arraycopy: length " + (length - from) + " is negative");
+        }
+        return newLength;
+    }
+
     public static boolean[] copyOfRange(boolean[] array, int from, int to) {
-        boolean[] result = new boolean[to - from];
-        for (int i = from; i < to; ++i) {
-            result[i - from] = array[i];
+        boolean[] result = new boolean[copyOfRangeLength(array.length, from, to, "boolean")];
+        int sz = TMath.min(array.length - from, result.length);
+        for (int i = 0; i < sz; ++i) {
+            result[i] = array[from + i];
         }
         return result;
     }
 
