+    // teavm-fork: TeaVM's classlib declares some JDK methods under another name plus @Rename (e.g.
+    // TThrowable.getMessage0() is @Rename("getMessage"), TObject.getClass0() is @Rename("getClass")).
+    // The converter used to export them under the Java-side name, so javac reported
+    // "cannot find symbol: method getMessage()". Key: name + descriptor (original), value: JDK name.
+    private final Map<String, String> renames;
 
     public StdlibConverter(ClassVisitor cv) {
+        this(cv, Map.of());
+    }
+
+    public StdlibConverter(ClassVisitor cv, Map<String, String> renames) {
         super(Opcodes.ASM9, cv);
+        this.renames = renames;
+    }
+
+    static Map<String, String> collectRenames(byte[] classFile) {
+        var declared = new HashSet<String>();
+        var candidates = new HashMap<String, String>();
+        new ClassReader(classFile).accept(new ClassVisitor(Opcodes.ASM9) {
+            @Override
+            public MethodVisitor visitMethod(int access, String name, String desc, String signature,
+                    String[] exceptions) {
+                declared.add(name + desc);
+                return new MethodVisitor(Opcodes.ASM9) {
+                    @Override
+                    public AnnotationVisitor visitAnnotation(String annotationDesc, boolean visible) {
+                        if (!annotationDesc.equals("Lorg/teavm/interop/Rename;")) {
+                            return null;
+                        }
+                        return new AnnotationVisitor(Opcodes.ASM9) {
+                            @Override
+                            public void visit(String key, Object value) {
+                                // Only plain method renames; TeaVM also uses @Rename to swap
+                                // constructors with init() methods ("<init>" / "fakeInit"), which the
+                                // API stub must keep as they are.
+                                if (key.equals("value") && value instanceof String target
+                                        && !name.startsWith("<") && !target.startsWith("<")
+                                        && !target.equals("fakeInit")) {
+                                    candidates.put(name + desc, target);
+                                }
+                            }
+                        };
+                    }
+                };
+            }
+        }, ClassReader.SKIP_CODE | ClassReader.SKIP_FRAMES | ClassReader.SKIP_DEBUG);
+        var result = new HashMap<String, String>();
+        for (var entry : candidates.entrySet()) {
+            var desc = entry.getKey().substring(entry.getKey().indexOf('('));
+            if (!declared.contains(entry.getValue() + desc)) {
+                result.put(entry.getKey(), entry.getValue());
+            }
+        }
+        return result;
     }
 
