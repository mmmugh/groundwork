 package org.teavm.classlib.java.lang;
 
 import java.io.IOException;
+import org.teavm.classlib.PlatformDetector;
 import org.teavm.classlib.java.io.TEOFException;
 import org.teavm.classlib.java.io.TInputStream;
+import org.teavm.interop.Import;
 
 class TConsoleInputStream extends TInputStream {
+    // teavm-fork: on Wasm GC, System.in reads bytes from the host through one import,
+    // teavmConsole.getcharStdin() -> 0..255, or -1 at end of input. The host decides where bytes come
+    // from: a buffer known up front (automated checks), or later a blocking interactive source
+    // (e.g. Atomics.wait on a SharedArrayBuffer inside a Worker). Other platforms keep the old
+    // behavior (EOFException). If the host provides no import, the program fails to instantiate
+    // only when it actually uses System.in.
+    private boolean closed;
+
+    @Import(module = "teavmConsole", name = "getcharStdin")
+    private static native int getcharStdin();
+
     @Override
-    public int read(byte[] b) throws IOException {
+    public int read() throws IOException {
+        if (PlatformDetector.isWebAssemblyGC()) {
+            if (closed) {
+                throw new IOException("Stream closed");
+            }
+            int b = getcharStdin();
+            return b < 0 ? -1 : b & 0xFF;
+        }
         throw new TEOFException();
     }
 
     @Override
-    public int read() throws IOException {
-        throw new TEOFException();
+    public int read(byte[] b) throws IOException {
+        return read(b, 0, b.length);
+    }
+
+    @Override
+    public int read(byte[] b, int off, int len) throws IOException {
+        if (!PlatformDetector.isWebAssemblyGC()) {
+            throw new TEOFException();
+        }
+        if (len == 0) {
+            return 0;
+        }
+        // Like a terminal: return at most one line per call, so an interactive source is never asked
+        // for more bytes than the program has consumed.
+        int first = read();
+        if (first < 0) {
+            return -1;
+        }
+        b[off] = (byte) first;
+        int count = 1;
+        while (count < len && first != '\n') {
+            int next = read();
+            if (next < 0) {
+                break;
+            }
+            b[off + count++] = (byte) next;
+            first = next;
+        }
+        return count;
+    }
+
+    @Override
+    public void close() throws IOException {
+        closed = true;
     }
 }
