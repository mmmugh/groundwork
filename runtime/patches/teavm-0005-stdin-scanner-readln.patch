 package org.teavm.classlib.java.lang;
 
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import org.teavm.classlib.impl.console.Utf8InputDecoder;
+
 public final class TIO {
+    // teavm-fork: readln() / readln(String) (JDK 25, JEP 512) read System.in as UTF-8.
+    // Line terminators match BufferedReader.readLine (the JDK's implementation): \n, \r, \r\n.
+    // Difference from the JDK: the JDK wraps System.in in an 8 KiB BufferedReader, so when input is
+    // piped it may read ahead past the line; this reads exactly one line, so mixing IO.readln with a
+    // Scanner behaves as it does on an interactive terminal.
+    private static Utf8InputDecoder decoder;
+    private static Object decoderSource;
+    private static boolean skipLF;
+
     private TIO() {
         throw new Error();
     }
@@ -30,5 +43,40 @@ public final class TIO {
 
     public static void print(Object obj) {
         System.out.print(obj);
+        System.out.flush();
+    }
+
+    public static String readln(String prompt) {
+        print(prompt);
+        return readln();
+    }
+
+    public static String readln() {
+        try {
+            if (decoder == null || decoderSource != System.in) {
+                decoderSource = System.in;
+                decoder = new Utf8InputDecoder(System.in);
+                skipLF = false;
+            }
+            StringBuilder sb = new StringBuilder();
+            int c = decoder.read();
+            if (skipLF && c == '\n') {
+                c = decoder.read();
+            }
+            skipLF = false;
+            if (c < 0) {
+                return null;
+            }
+            while (c >= 0 && c != '\n' && c != '\r') {
+                sb.append((char) c);
+                c = decoder.read();
+            }
+            if (c == '\r') {
+                skipLF = true;
+            }
+            return sb.toString();
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
     }
 }
