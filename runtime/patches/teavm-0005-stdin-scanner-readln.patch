@@ -0,0 +1,482 @@
+/*
+ *  Copyright 2026 Groundwork contributors.
+ *
+ *  Licensed under the Apache License, Version 2.0 (the "License");
+ *  you may not use this file except in compliance with the License.
+ *  You may obtain a copy of the License at
+ *
+ *       http://www.apache.org/licenses/LICENSE-2.0
+ *
+ *  Unless required by applicable law or agreed to in writing, software
+ *  distributed under the License is distributed on an "AS IS" BASIS,
+ *  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ */
+package org.teavm.classlib.java.util;
+
+import java.io.Closeable;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Iterator;
+import java.util.NoSuchElementException;
+import org.teavm.classlib.impl.console.Utf8InputDecoder;
+
+/**
+ * teavm-fork: a subset of java.util.Scanner for first-course programs, with the JDK 25 behavior for
+ * the default whitespace delimiter and US-locale numbers:
+ * next, nextLine, nextInt, nextLong, nextDouble, nextBoolean, hasNext, hasNextLine, hasNextInt,
+ * hasNextLong, hasNextDouble, close; constructors Scanner(InputStream) and Scanner(String).
+ * As in the JDK: hasNextX() never consumes input, a token that fails nextX() is not consumed,
+ * nextLine() returns the rest of the current line (so nextInt() then nextLine() returns ""),
+ * line terminators are \r\n, \n, \r,  ,  , \u0085.
+ * Not implemented: custom delimiters/patterns (useDelimiter, findInLine, skip), radix and locale
+ * variants, hex floating point input, Unicode (non-ASCII) digits.
+ * Input is read lazily one line at a time (never ahead of what the program asks for), which is how
+ * the JDK behaves on an interactive terminal; with piped input the JDK reads ahead in 1 KiB chunks.
+ */
+public final class TScanner implements Iterator<String>, Closeable {
+    private static final int COMPACT_THRESHOLD = 8192;
+    private final Utf8InputDecoder decoder;
+    private final Closeable source;
+    private final StringBuilder buf = new StringBuilder();
+    private int pos;
+    private boolean eof;
+    private boolean closed;
+    private int tokenStart;
+
+    public TScanner(InputStream source) {
+        if (source == null) {
+            throw new NullPointerException();
+        }
+        this.decoder = new Utf8InputDecoder(source);
+        this.source = source;
+    }
+
+    public TScanner(String source) {
+        if (source == null) {
+            throw new NullPointerException();
+        }
+        this.decoder = null;
+        this.source = null;
+        buf.append(source);
+        eof = true;
+    }
+
+    // Reads the next line of input (up to and including '\n') into the buffer.
+    private boolean fill() {
+        if (eof) {
+            return false;
+        }
+        boolean any = false;
+        try {
+            while (true) {
+                int c = decoder.read();
+                if (c < 0) {
+                    eof = true;
+                    break;
+                }
+                buf.append((char) c);
+                any = true;
+                if (c == '\n') {
+                    break;
+                }
+            }
+        } catch (IOException e) {
+            eof = true;
+        }
+        return any;
+    }
+
+    private void ensureOpen() {
+        if (closed) {
+            throw new IllegalStateException("Scanner closed");
+        }
+        if (pos > COMPACT_THRESHOLD && pos * 2 > buf.length()) {
+            buf.delete(0, pos);
+            pos = 0;
+        }
+    }
+
+    private boolean isDelimiter(int index) {
+        return Character.isWhitespace(buf.charAt(index));
+    }
+
+    // Finds the next token without consuming anything. Returns its end index (tokenStart is set),
+    // or -1 if the input has no more tokens.
+    private int findToken() {
+        int i = pos;
+        while (true) {
+            while (i < buf.length() && isDelimiter(i)) {
+                i++;
+            }
+            if (i < buf.length()) {
+                break;
+            }
+            if (!fill()) {
+                return -1;
+            }
+        }
+        tokenStart = i;
+        int j = i;
+        while (true) {
+            while (j < buf.length() && !isDelimiter(j)) {
+                j++;
+            }
+            if (j < buf.length() || !fill()) {
+                break;
+            }
+        }
+        return j;
+    }
+
+    @Override
+    public boolean hasNext() {
+        ensureOpen();
+        return findToken() >= 0;
+    }
+
+    @Override
+    public String next() {
+        ensureOpen();
+        int end = findToken();
+        if (end < 0) {
+            throw new NoSuchElementException();
+        }
+        String token = buf.substring(tokenStart, end);
+        pos = end;
+        return token;
+    }
+
+    @Override
+    public void remove() {
+        throw new UnsupportedOperationException();
+    }
+
+    public boolean hasNextLine() {
+        ensureOpen();
+        return pos < buf.length() || fill();
+    }
+
+    public String nextLine() {
+        ensureOpen();
+        int i = pos;
+        while (true) {
+            while (i < buf.length()) {
+                char c = buf.charAt(i);
+                if (c == '\n' || c == '\r' || c == ' ' || c == ' ' || c == '\u0085') {
+                    String line = buf.substring(pos, i);
+                    int next = i + 1;
+                    if (c == '\r') {
+                        if (next >= buf.length()) {
+                            fill();
+                        }
+                        if (next < buf.length() && buf.charAt(next) == '\n') {
+                            next++;
+                        }
+                    }
+                    pos = next;
+                    return line;
+                }
+                i++;
+            }
+            if (!fill()) {
+                break;
+            }
+        }
+        if (pos >= buf.length()) {
+            throw new NoSuchElementException("No line found");
+        }
+        String line = buf.substring(pos);
+        pos = buf.length();
+        return line;
+    }
+
+    // ---- integers -------------------------------------------------------------------------------
+
+    private String peekIntegerDigits() {
+        int end = findToken();
+        if (end < 0) {
+            return null;
+        }
+        return integerDigits(buf.substring(tokenStart, end));
+    }
+
+    // JDK integer pattern (US locale): [-+]? (digits | grouped digits "1,234,567"); returns the token
+    // with grouping removed, or null if the token is not an integer.
+    private static String integerDigits(String token) {
+        int i = 0;
+        StringBuilder sb = new StringBuilder();
+        if (i < token.length() && (token.charAt(i) == '-' || token.charAt(i) == '+')) {
+            if (token.charAt(i) == '-') {
+                sb.append('-');
+            }
+            i++;
+        }
+        String numeral = token.substring(i);
+        String digits = numeralDigits(numeral);
+        if (digits == null || digits.length() != numeral.length() - countCommas(numeral)) {
+            return null;
+        }
+        return sb.append(digits).toString();
+    }
+
+    private static int countCommas(String s) {
+        int n = 0;
+        for (int i = 0; i < s.length(); ++i) {
+            if (s.charAt(i) == ',') {
+                n++;
+            }
+        }
+        return n;
+    }
+
+    // numeral := digit+ | [1-9] digit? digit? (',' digit digit digit)+ ; returns digits without commas
+    private static String numeralDigits(String s) {
+        if (s.isEmpty()) {
+            return null;
+        }
+        if (s.indexOf(',') < 0) {
+            for (int i = 0; i < s.length(); ++i) {
+                if (!isAsciiDigit(s.charAt(i))) {
+                    return null;
+                }
+            }
+            return s;
+        }
+        int firstComma = s.indexOf(',');
+        if (firstComma < 1 || firstComma > 3 || s.charAt(0) == '0') {
+            return null;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < firstComma; ++i) {
+            if (!isAsciiDigit(s.charAt(i))) {
+                return null;
+            }
+            sb.append(s.charAt(i));
+        }
+        int i = firstComma;
+        while (i < s.length()) {
+            // each group is exactly ",ddd"
+            if (s.charAt(i) != ',' || i + 3 >= s.length()) {
+                return null;
+            }
+            for (int k = 1; k <= 3; ++k) {
+                if (!isAsciiDigit(s.charAt(i + k))) {
+                    return null;
+                }
+                sb.append(s.charAt(i + k));
+            }
+            i += 4;
+        }
+        return sb.toString();
+    }
+
+    private static boolean isAsciiDigit(char c) {
+        return c >= '0' && c <= '9';
+    }
+
+    public boolean hasNextInt() {
+        ensureOpen();
+        String digits = peekIntegerDigits();
+        if (digits == null) {
+            return false;
+        }
+        try {
+            Integer.parseInt(digits);
+            return true;
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
+
+    public int nextInt() {
+        ensureOpen();
+        int end = findToken();
+        if (end < 0) {
+            throw new NoSuchElementException();
+        }
+        String digits = integerDigits(buf.substring(tokenStart, end));
+        if (digits == null) {
+            throw new TInputMismatchException();
+        }
+        try {
+            int value = Integer.parseInt(digits);
+            pos = end;
+            return value;
+        } catch (NumberFormatException e) {
+            throw new TInputMismatchException(e.getMessage());
+        }
+    }
+
+    public boolean hasNextLong() {
+        ensureOpen();
+        String digits = peekIntegerDigits();
+        if (digits == null) {
+            return false;
+        }
+        try {
+            Long.parseLong(digits);
+            return true;
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
+
+    public long nextLong() {
+        ensureOpen();
+        int end = findToken();
+        if (end < 0) {
+            throw new NoSuchElementException();
+        }
+        String digits = integerDigits(buf.substring(tokenStart, end));
+        if (digits == null) {
+            throw new TInputMismatchException();
+        }
+        try {
+            long value = Long.parseLong(digits);
+            pos = end;
+            return value;
+        } catch (NumberFormatException e) {
+            throw new TInputMismatchException(e.getMessage());
+        }
+    }
+
+    // ---- floating point -------------------------------------------------------------------------
+
+    // JDK float pattern (US locale, without hex floats): [-+]? ( NaN | Infinity | ∞ |
+    // numeral ( '.' digit* )? exponent? | '.' digit+ exponent? ); returns a Double.parseDouble string.
+    private static String floatText(String token) {
+        int i = 0;
+        String sign = "";
+        if (i < token.length() && (token.charAt(i) == '-' || token.charAt(i) == '+')) {
+            sign = token.charAt(i) == '-' ? "-" : "";
+            i++;
+        }
+        String rest = token.substring(i);
+        if (rest.equals("NaN")) {
+            return "NaN";
+        }
+        if (rest.equals("Infinity") || rest.equals("∞")) {
+            return sign + "Infinity";
+        }
+        int exp = -1;
+        for (int k = 0; k < rest.length(); ++k) {
+            char c = rest.charAt(k);
+            if (c == 'e' || c == 'E') {
+                exp = k;
+                break;
+            }
+        }
+        String mantissa = exp >= 0 ? rest.substring(0, exp) : rest;
+        String exponent = exp >= 0 ? rest.substring(exp + 1) : null;
+        if (exponent != null) {
+            int e = 0;
+            if (e < exponent.length() && (exponent.charAt(e) == '+' || exponent.charAt(e) == '-')) {
+                e++;
+            }
+            if (e >= exponent.length()) {
+                return null;
+            }
+            for (; e < exponent.length(); ++e) {
+                if (!isAsciiDigit(exponent.charAt(e))) {
+                    return null;
+                }
+            }
+        }
+        int dot = mantissa.indexOf('.');
+        String intPart = dot >= 0 ? mantissa.substring(0, dot) : mantissa;
+        String fracPart = dot >= 0 ? mantissa.substring(dot + 1) : "";
+        String intDigits;
+        if (intPart.isEmpty()) {
+            if (dot < 0 || fracPart.isEmpty()) {
+                return null;
+            }
+            intDigits = "0";
+        } else {
+            intDigits = numeralDigits(intPart);
+            if (intDigits == null || intDigits.length() != intPart.length() - countCommas(intPart)) {
+                return null;
+            }
+        }
+        for (int k = 0; k < fracPart.length(); ++k) {
+            if (!isAsciiDigit(fracPart.charAt(k))) {
+                return null;
+            }
+        }
+        StringBuilder sb = new StringBuilder(sign).append(intDigits);
+        if (!fracPart.isEmpty()) {
+            sb.append('.').append(fracPart);
+        }
+        if (exponent != null) {
+            sb.append('e').append(exponent);
+        }
+        return sb.toString();
+    }
+
+    public boolean hasNextDouble() {
