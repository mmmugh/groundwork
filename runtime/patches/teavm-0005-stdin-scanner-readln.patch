+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ */
+package org.teavm.classlib.impl.console;
+
+import java.io.IOException;
+import java.io.InputStream;
+
+/**
+ * teavm-fork: decodes UTF-8 bytes from an InputStream into UTF-16 chars, one char at a time,
+ * reading no more bytes than needed. Used instead of InputStreamReader, whose charset machinery
+ * (TByteBuffer/TCharBuffer with @JSByRef) does not build for Wasm GC in TeaVM 0.13.1.
+ * Malformed input becomes U+FFFD, like the JDK's default REPLACE action.
+ */
+public final class Utf8InputDecoder {
+    private final InputStream in;
+    private int pendingLowSurrogate = -1;
+
+    public Utf8InputDecoder(InputStream in) {
+        this.in = in;
+    }
+
+    /** @return the next UTF-16 char, or -1 at end of input. */
+    public int read() throws IOException {
+        if (pendingLowSurrogate >= 0) {
+            int c = pendingLowSurrogate;
+            pendingLowSurrogate = -1;
+            return c;
+        }
+        int b = in.read();
+        if (b < 0) {
+            return -1;
+        }
+        if (b < 0x80) {
+            return b;
+        }
+        int extra;
+        int code;
+        if ((b & 0xE0) == 0xC0) {
+            extra = 1;
+            code = b & 0x1F;
+        } else if ((b & 0xF0) == 0xE0) {
+            extra = 2;
+            code = b & 0x0F;
+        } else if ((b & 0xF8) == 0xF0) {
+            extra = 3;
+            code = b & 0x07;
+        } else {
+            return 0xFFFD;
+        }
+        for (int i = 0; i < extra; ++i) {
+            int next = in.read();
+            if (next < 0 || (next & 0xC0) != 0x80) {
+                return 0xFFFD;
+            }
+            code = (code << 6) | (next & 0x3F);
+        }
+        if (code >= 0x10000) {
+            pendingLowSurrogate = Character.lowSurrogate(code);
+            return Character.highSurrogate(code);
+        }
+        return code;
+    }
+}
