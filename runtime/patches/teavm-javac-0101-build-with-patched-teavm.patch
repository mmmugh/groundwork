# Build: -Pteavm.forkRepo=<dir> adds a file-based Maven repo holding org.teavm:teavm-core and
# teavm-classlib 0.13.1-fork1 (TeaVM 0.13.1 + the teavm-000x patches, built by
# overlay/build-overlay.sh) and rewrites every request for those two artifacts to that version.
# Without the property the build is unchanged.
#
# Applies to: github.com/konsoletyper/teavm-javac 2ddcf02e (master, 2026-09-04)

diff --git a/settings.gradle b/settings.gradle
index ffbfff4..471f3ae 100644
--- a/settings.gradle
+++ b/settings.gradle
@@ -23,8 +23,19 @@ pluginManagement {
      }
 }
 
+// teavm-fork: -Pteavm.forkRepo=<dir> points at a file-based Maven repo holding patched
+// org.teavm:teavm-core / teavm-classlib 0.13.1-fork1 (built by overlay/build-overlay.sh), and every
+// request for those two artifacts is rewritten to that version (the Gradle plugin itself stays 0.13.1).
+def teavmForkRepo = providers.gradleProperty("teavm.forkRepo")
+
 dependencyResolutionManagement {
     repositories {
+        if (teavmForkRepo.isPresent()) {
+            maven {
+                name = "teavmFork"
+                url = uri(teavmForkRepo.get())
+            }
+        }
         maven { url = uri("https://teavm.org/maven/repository") }
         mavenCentral()
         mavenLocal()
@@ -51,6 +62,20 @@ gradle.allprojects {
     }
 }
 
+if (teavmForkRepo.isPresent()) {
+    gradle.allprojects {
+        configurations.configureEach {
+            resolutionStrategy.eachDependency { details ->
+                if (details.requested.group == "org.teavm"
+                        && details.requested.name in ["teavm-core", "teavm-classlib"]) {
+                    details.useVersion("0.13.1-fork1")
+                    details.because("teavm-fork patches")
+                }
+            }
+        }
+    }
+}
+
 gradle.afterProject {
     def java = extensions.findByType(JavaPluginExtension)
     if (java != null) {
