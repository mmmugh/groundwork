# D11. Numbers the Javadoc pins down exactly. Written from the public Javadoc of Math, Float and Double
# (Java SE 25) and the pinned JDK's observed output only (clean room, D14); no OpenJDK source was opened.
#   - Math.round(double), Math.round(float): the closest long (int), ties toward positive infinity, so
#     round(-2.5) is -2 (was -3), and round(0.49999999999999994) is 0 (was 1). NaN gives 0; infinities
#     and out-of-range values give Long/Integer.MIN_VALUE or MAX_VALUE.
#   - Float.MIN_VALUE and Float.MIN_NORMAL were swapped: MIN_VALUE is now 0x0.000002P-126f (1.4E-45) and
#     MIN_NORMAL 0x1.0p-126f (1.1754944E-38).
#   - Float.toString and Double.toString of a subnormal: the neighbors of a subnormal are one unit of the
#     smallest exponent away, so the interval of decimals that round to it is wider than the analyzers
#     assumed, and they printed too many digits (4.940656458412465E-324). And when the shortest decimal
#     has one digit, the Javadoc picks the closest decimal of one or two digits: Double.MIN_VALUE is
#     4.9E-324, Float.MIN_VALUE 1.4E-45. Normal numbers print exactly as before.
#   - Math.log10: exact n for 10^n (log10(1000) was 2.9999999999999996), from a = m * 2^k and
#     log10(a) = k * log10(2) + ln(m) / ln(10), with k * log10(2) computed exactly.
#
# Applies to: github.com/konsoletyper/teavm tag 0.13.1 (b3a245b7), after teavm-0001 to teavm-0009; it
# touches no line an earlier patch added, so the patch applies in every leave-one-out build, which leaves
# out one patch and the patches that declare they build on it.

diff --git a/classlib/src/main/java/org/teavm/classlib/impl/text/DoubleAnalyzer.java b/classlib/src/main/java/org/teavm/classlib/impl/text/DoubleAnalyzer.java
index 90b25b9..e468caf 100644
--- a/classlib/src/main/java/org/teavm/classlib/impl/text/DoubleAnalyzer.java
+++ b/classlib/src/main/java/org/teavm/classlib/impl/text/DoubleAnalyzer.java
@@ -57,6 +57,11 @@ public final class DoubleAnalyzer {
         } else {
             mantissa |= 1L << 52;
         }
+        // teavm-fork: a subnormal's neighbors are 2^-1074 away however far its mantissa was shifted up above,
+        // so the half-gap to them (in units of the doubled mantissa used below) is 2^shift, not 1. Treating
+        // it as 1 printed Double.MIN_VALUE as 4.940656458412465E-324 where the Javadoc's shortest decimal
+        // gives 4.9E-324.
+        int subnormalShift = exponent > 0 ? 0 : 1 - exponent;
 
         int decExponent = Arrays.binarySearch(exp10Table, (short) exponent);
         if (decExponent < 0) {
@@ -75,9 +80,20 @@ public final class DoubleAnalyzer {
             mantissaShift = 12 + binExponentCorrection;
             decMantissa = mulAndShiftRight(mantissa, mantissa10Table[decExponent + 1], mantissaShift);
         }
-        var decMantissaHi = mulAndShiftRight((mantissa << 1) + 1, mantissa10Table[decExponent + 1],
+        if (subnormalShift > 0) {
+            // teavm-fork: one digit fewer (still 18, more than a subnormal needs), so the widened upper bound
+            // fits in 64 bits
+            ++decExponent;
+            binExponentCorrection = exponent - exp10Table[decExponent + 1];
+            mantissaShift = 12 + binExponentCorrection;
+            decMantissa = mulAndShiftRight(mantissa, mantissa10Table[decExponent + 1], mantissaShift);
+        }
+        long exact = decMantissa;
+        int exactExponent = decExponent;
+        long halfGap = 1L << subnormalShift;
+        var decMantissaHi = mulAndShiftRight((mantissa << 1) + halfGap, mantissa10Table[decExponent + 1],
                 mantissaShift - 1);
-        var decMantissaLow = mulAndShiftRight((mantissa << 1) - 1, mantissa10Table[decExponent + 1],
+        var decMantissaLow = mulAndShiftRight((mantissa << 1) - halfGap, mantissa10Table[decExponent + 1],
                 mantissaShift - 1);
 
         var lowerPos = findLowerDistance(decMantissa, decMantissaLow);
@@ -101,6 +117,25 @@ public final class DoubleAnalyzer {
             decMantissa *= 10;
         }
 
+        if (Long.remainderUnsigned(decMantissa, 100000000000000000L) == 0) {
+            // teavm-fork: the Javadoc of Double.toString: when the shortest decimal has one digit, the choice
+            // is the decimal of one or two digits closest to the value (Double.MIN_VALUE is 4.9E-324, not
+            // 5.0E-324). exact / unit has three digits; round them to two.
+            long unit = 1000000000000000L;
+            int e = exactExponent;
+            while (Long.compareUnsigned(Long.divideUnsigned(exact, unit), 1000) >= 0) {
+                unit *= 10;
+                e++;
+            }
+            long two = (Long.divideUnsigned(exact, unit) + 5) / 10;
+            if (two == 100) {
+                two = 10;
+                e++;
+            }
+            decMantissa = two * 10000000000000000L;
+            decExponent = e;
+        }
+
         result.mantissa = decMantissa;
         result.exponent = decExponent - MAX_ABS_DEC_EXP;
     }
