+            return 0;
+        }
+        if (a >= 0x1p23f || a <= -0x1p23f) {
+            return (int) a;
+        }
+        float floor = (float) floor(a);
+        return (int) floor + (a - floor >= 0.5f ? 1 : 0);
     }
 
