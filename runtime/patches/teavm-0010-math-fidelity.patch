                 mantissaShift - 1);
 
         var lowerPos = findLowerDistance(decMantissa, decMantissaLow);
@@ -90,6 +104,26 @@ public final class FloatAnalyzer {
             decMantissa *= 10;
         }
 
+        if (Integer.remainderUnsigned(decMantissa, 100000000) == 0) {
+            // teavm-fork: the Javadoc of Float.toString: when the shortest decimal has one digit, the choice
+            // is the decimal of one or two digits closest to the value (Float.MIN_VALUE is 1.4E-45, not
+            // 1.0E-45). exact / unit has three digits; round them to two.
+            long exactUnsigned = exact & 0xFFFFFFFFL;
+            long unit = 100000;
+            int e = exactExponent - 1;
+            while (exactUnsigned / unit >= 1000) {
+                unit *= 10;
+                e++;
+            }
+            long two = (exactUnsigned / unit + 5) / 10;
+            if (two == 100) {
+                two = 10;
