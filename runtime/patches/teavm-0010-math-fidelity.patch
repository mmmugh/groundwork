@@ -80,8 +80,37 @@ public final class TMath extends TObject {
     @Unmanaged
     public static native double log(double a);
 
+    // teavm-fork: written from the Javadoc (NaN or negative gives NaN, +0 and -0 give -Infinity, +Infinity
+    // gives +Infinity, 10^n gives exactly n, within 1 ulp). Dividing ln(a) by ln(10) put its rounding
+    // errors on the whole result, so log10(1000) came out 2.9999999999999996. Here a = m * 2^k with
+    // m in (sqrt(1/2), sqrt(2)], and log10(a) = k * log10(2) + ln(m) / ln(10): k * LOG10_2_HI is exact
+    // (the constant ends in 11 zero bits), so the rounding errors left sit in the small second term.
+    private static final double LOG10_2_HI = 0x1.34413509f7800p-2;
+    private static final double LOG10_2_LO = 0x1.fef311f12b358p-46;
+
     public static double log10(double a) {
-        return log(a) / 2.302585092994046 /* log_e 10 */;
+        if (a != a || a < 0) {
+            return Double.NaN;
+        }
+        if (a == 0) {
+            return Double.NEGATIVE_INFINITY;
+        }
+        if (a == Double.POSITIVE_INFINITY) {
+            return a;
+        }
+        int k = 0;
+        if (a < 0x1p-1022) {
+            a *= 0x1p54;
+            k = -54;
+        }
+        long bits = Double.doubleToRawLongBits(a);
+        k += (int) (bits >>> 52) - 1023;
+        double m = Double.longBitsToDouble((bits & 0x000FFFFFFFFFFFFFL) | 0x3FF0000000000000L);
+        if (m > 1.4142135623730951) {
+            m *= 0.5;
+            k++;
+        }
+        return k * LOG10_2_HI + (k * LOG10_2_LO + log(m) * 0.4342944819032518 /* 1 / log_e 10 */);
     }
 
