+package org.teavm.classlib.java.net;
+
+/**
+ * teavm-fork: java.net.ConnectException, which TeaVM's class library lacked. TXHRURLConnection
+ * throws it for an address literal, which a computer with no network cannot reach.
+ */
+public class TConnectException extends TSocketException {
+    public TConnectException() {
+        super();
+    }
+
+    public TConnectException(String detailMessage) {
+        super(detailMessage);
+    }
+}
