diff --git a/classlib/src/main/java/org/teavm/classlib/java/lang/TThrowable.java b/classlib/src/main/java/org/teavm/classlib/java/lang/TThrowable.java
index 03c1aaf..185a8c8 100644
--- a/classlib/src/main/java/org/teavm/classlib/java/lang/TThrowable.java
+++ b/classlib/src/main/java/org/teavm/classlib/java/lang/TThrowable.java
@@ -211,8 +211,10 @@ public class TThrowable extends RuntimeException {
         ensureStackTrace();
         if (stackTrace != null) {
             for (TStackTraceElement element : stackTrace) {
-                stream.print("\tat ");
-                stream.println(element);
+                // teavm-fork: one print per frame, so the host sees each frame's line whole: every print
+                // on System.err now reaches the host at once, and the course's runner judges a line (keep
+                // or hide the frame) by the first part it receives. The printed text is unchanged.
+                stream.println("\tat " + element);
             }
         }
         if (cause != null && cause != this) {
