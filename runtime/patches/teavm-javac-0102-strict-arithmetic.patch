+ *  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ */
+package org.teavm.javac;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.teavm.javac.rt.StrictArithmetic;
+import org.teavm.model.BasicBlock;
+import org.teavm.model.ClassHolder;
+import org.teavm.model.ClassHolderTransformer;
+import org.teavm.model.ClassHolderTransformerContext;
+import org.teavm.model.Instruction;
+import org.teavm.model.MethodHolder;
+import org.teavm.model.MethodReference;
+import org.teavm.model.Phi;
+import org.teavm.model.Program;
+import org.teavm.model.ValueType;
+import org.teavm.model.instructions.BinaryInstruction;
+import org.teavm.model.instructions.BinaryOperation;
+import org.teavm.model.instructions.IntegerConstantInstruction;
+import org.teavm.model.instructions.InvocationType;
+import org.teavm.model.instructions.InvokeInstruction;
+import org.teavm.model.instructions.LongConstantInstruction;
+import org.teavm.model.instructions.NumericOperandType;
+import org.teavm.model.util.DefinitionExtractor;
+
+/**
+ * Replaces int/long division and remainder with calls to {@link StrictArithmetic}, unless the divisor
+ * is a constant other than 0 and -1. Runs as a class transformer, i.e. before dependency analysis, so
+ * the ArithmeticException thrown by the helper is visible to the analysis like any explicit throw.
+ */
+public class StrictArithmeticTransformer implements ClassHolderTransformer {
+    private static final String HELPER = StrictArithmetic.class.getName();
+    private final boolean allClasses;
+
+    /**
+     * @param allClasses true: every class except TeaVM's own runtime (org.teavm.*); false: nothing
+     *                   unless {@link #transformMethods} is called directly.
+     */
+    public StrictArithmeticTransformer(boolean allClasses) {
+        this.allClasses = allClasses;
+    }
+
+    @Override
+    public void transformClass(ClassHolder cls, ClassHolderTransformerContext context) {
+        if (!allClasses || cls.getName().startsWith("org.teavm.") || cls.getName().equals(HELPER)) {
+            return;
+        }
+        transformMethods(cls);
+    }
+
+    public static void transformMethods(ClassHolder cls) {
+        for (MethodHolder method : cls.getMethods()) {
+            if (method.getProgram() != null) {
+                transformProgram(method.getProgram());
+            }
+        }
+    }
+
+    static void transformProgram(Program program) {
+        Map<Integer, Long> constants = new HashMap<>();
+        Set<Integer> multiplyDefined = new HashSet<>();
+        Set<Integer> defined = new HashSet<>();
+        DefinitionExtractor defs = new DefinitionExtractor();
+        for (BasicBlock block : program.getBasicBlocks()) {
+            for (Phi phi : block.getPhis()) {
+                if (!defined.add(phi.getReceiver().getIndex())) {
+                    multiplyDefined.add(phi.getReceiver().getIndex());
+                }
+            }
+            for (Instruction insn : block) {
+                insn.acceptVisitor(defs);
+                for (var v : defs.getDefinedVariables()) {
+                    if (!defined.add(v.getIndex())) {
+                        multiplyDefined.add(v.getIndex());
+                    }
+                }
+                if (insn instanceof IntegerConstantInstruction c) {
+                    constants.put(c.getReceiver().getIndex(), (long) c.getConstant());
+                } else if (insn instanceof LongConstantInstruction c) {
+                    constants.put(c.getReceiver().getIndex(), c.getConstant());
+                }
+            }
+        }
+        List<BinaryInstruction> targets = new ArrayList<>();
+        for (BasicBlock block : program.getBasicBlocks()) {
+            for (Instruction insn : block) {
+                if (insn instanceof BinaryInstruction binary) {
+                    targets.add(binary);
+                }
+            }
+        }
+        for (BinaryInstruction binary : targets) {
+            boolean div = binary.getOperation() == BinaryOperation.DIVIDE;
+            if (!div && binary.getOperation() != BinaryOperation.MODULO) {
+                continue;
+            }
+            NumericOperandType type = binary.getOperandType();
+            if (type != NumericOperandType.INT && type != NumericOperandType.LONG) {
+                continue;
+            }
+            int divisor = binary.getSecondOperand().getIndex();
+            Long constant = multiplyDefined.contains(divisor) ? null : constants.get(divisor);
+            if (constant != null && constant != 0 && constant != -1) {
+                continue;
+            }
+            Class<?> t = type == NumericOperandType.INT ? int.class : long.class;
+            String name = (type == NumericOperandType.INT ? "i" : "l") + (div ? "div" : "rem");
+            InvokeInstruction call = new InvokeInstruction();
+            call.setType(InvocationType.SPECIAL);
+            call.setMethod(new MethodReference(HELPER, name, ValueType.parse(t),
+                    ValueType.parse(t), ValueType.parse(t)));
+            call.setArguments(binary.getFirstOperand(), binary.getSecondOperand());
+            call.setReceiver(binary.getReceiver());
+            call.setLocation(binary.getLocation());
+            binary.replace(call);
+        }
+    }
+}
