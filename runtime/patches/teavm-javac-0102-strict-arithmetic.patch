+++ b/compiler/src/main/java/org/teavm/javac/Patches.java
@@ -56,6 +56,13 @@ public class Patches implements TeaVMPlugin, ClassHolderTransformer {
             case "java.lang.System":
                 transformSystem(cls, context);
                 break;
+            case "com.sun.tools.javac.comp.ConstFold":
+                // teavm-fork: ConstFold.fold2 folds constant int/long division and relies on
+                // catch (ArithmeticException) for "x / 0". compiler.wasm is not built in strict mode, so
+                // that division was a Wasm trap that killed the compiler ("10 / 0" in any program, and
+                // Integer.MIN_VALUE / -1). Route the divisions through StrictArithmetic instead.
+                StrictArithmeticTransformer.transformMethods(cls);
+                break;
         }
     }
 
diff --git a/compiler/src/main/java/org/teavm/javac/StrictArithmeticTransformer.java b/compiler/src/main/java/org/teavm/javac/StrictArithmeticTransformer.java
new file mode 100644
index 0000000..4c98b55
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/StrictArithmeticTransformer.java
@@ -0,0 +1,136 @@
