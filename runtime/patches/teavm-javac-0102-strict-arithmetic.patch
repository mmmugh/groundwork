+package org.teavm.javac.rt;
+
+/**
+ * Java semantics for integer division, which Wasm does not have: i32.div_s / i64.div_s trap on a zero
+ * divisor and on MIN_VALUE / -1, where Java throws ArithmeticException("/ by zero") and wraps to
+ * MIN_VALUE respectively. Calls to these methods replace integer division and remainder (see
+ * StrictArithmeticTransformer). This class is compiled into compiler.wasm (for javac's ConstFold) and
+ * into runtime-classlib-teavm.bin (for user programs); it is not visible to javac (not in the SDK).
+ */
+public final class StrictArithmetic {
+    private StrictArithmetic() {
+    }
+
+    public static int idiv(int a, int b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? -a : a / b;
+    }
+
+    public static int irem(int a, int b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? 0 : a % b;
+    }
+
+    public static long ldiv(long a, long b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? -a : a / b;
+    }
+
+    public static long lrem(long a, long b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? 0 : a % b;
+    }
+}
