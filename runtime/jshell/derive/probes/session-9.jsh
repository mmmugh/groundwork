# debug with no argument
/debug

# a snippet after debug on
int x = 1

# debug off
/debug 0

# a snippet after debug off
int y = 2

# debug with a bad letter
/debug z

# debug with tool level flag
/debug r

# a snippet in tool debug
int w = 3

# turn off
/debug 0

# debug with the completion flag
/debug c

# a snippet
int v = 4

# off
/debug 0

# debug g
/debug g

# a snippet
int u = 5

# off
/debug 0

# debug f
/debug f

# off
/debug 0

# debug d
/debug d

# off
/debug 0

# debug e
/debug e

# off
/debug 0

# help text for debug again
/help /debug

# a plain snippet at the end
int t = 6
