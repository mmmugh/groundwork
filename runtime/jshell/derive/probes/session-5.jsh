# a variable
int x = 10

# value for numbering
x + 1

# a method
int dbl(int n) { return n * 2; }

# an import
import java.util.*;

# reset in normal mode
/reset

# history after reset in normal mode
/history

# vars after reset
/vars

# numbering restarts?
7 * 6

# feedback mode switch to silent
/set feedback silent

# reset in silent mode
/reset

# normal mode feedback
/set feedback normal

# a snippet
int a = 1

# reset with a trailing blank
/reset 

# list all after reset
/list -all

# reset twice
/reset

# reset twice 2
/reset

# an exception snippet
int[] arr = new int[2];

# an exception
arr[5]

# reset after exception
/reset

# a snippet after
int after = 1

# a failing snippet then reset
String s = 5;

# reset again
/reset

# the e id counter after reset
String s2 = 5;

# list
/list -all
