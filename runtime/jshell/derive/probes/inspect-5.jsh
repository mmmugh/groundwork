/his

# /hel
/hel

# /histo
/histo

# unknown command
/foo

# slash alone
/

# upper case
/LIST

# upper case vars
/VARS

# leading spaces
   /list

# leading tab-like spaces before vars
      /vars

# trailing spaces
/vars   

# extra arguments to vars
/vars x

# extra arguments to vars unknown
/vars nope

# extra arguments to methods
/methods f

# methods with unknown name
/methods nope

# types with name
/types C

# types with var name
/types x

# imports with arg
/imports java

# history with arg
/history 3

# history arg -all
/history -all

# list with leading dash only
/list -

# list -all and name
/list -all x

# list -start and -all
/list -start -all

# list double dash
/list --all

# list negative number
/list -1

# list zero
/list 0

# list large number
/list 999

# list a range with names
/list x-f

# list ranges
/list 1-2

# list reversed range
/list 3-1

# vars -all
/vars -all

# slash slash
//

# slash with a space
/ list

# a slash comment
/* comment */

# list s2
/list s2

# list e0
/list e0

# ambiguous command prefix /e
/e

# /s
/s

# /r
/r

# /ex
/ex
