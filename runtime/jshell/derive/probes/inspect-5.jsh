# seed
int x = 5

# seed method
int f() { return 1; }

# seed class
class C {}

# seed import
import java.util.*;

# abbreviation /l
/l

# /li
/li

# /v
/v

# /va
/va

# /m
/m

# /me
/me

# /t
/t

# /ty
/ty

